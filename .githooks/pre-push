#!/bin/sh
#
# Pre-push hook: refuse to push plugin content changes without a version change.
#
# The bump itself happens in .githooks/pre-commit; this hook only asserts the
# property that hook exists for (no bump -> installs never refresh), catching
# commits made with --no-verify or from a clone without core.hooksPath set.
#

remote=$1
zero=$(git hash-object --stdin </dev/null | tr '[0-9a-f]' '0')
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  case "$local_ref" in refs/heads/*) ;; *) continue ;; esac

  if [ "$remote_sha" != "$zero" ]; then
    base=$remote_sha
  else
    oldest=$(git rev-list "$local_sha" --not --remotes="$remote" | tail -1)
    [ -n "$oldest" ] || continue
    base=$(git rev-parse -q --verify "${oldest}^") || base=$(git hash-object -t tree /dev/null)
  fi

  read_version() {
    git show "$1:$2" 2>/dev/null |
      grep '"version"' | head -1 | sed 's/.*"version": *"\([^"]*\)".*/\1/'
  }

  for plugin_json in $(git ls-tree -r --name-only "$local_sha" | grep '^[^/]*/\.claude-plugin/plugin\.json$'); do
    plugin=${plugin_json%%/.claude-plugin/plugin.json}

    changed=$(git diff --name-only "$base" "$local_sha" -- "$plugin/" | grep -v "^${plugin_json}$")
    [ -n "$changed" ] || continue

    pushed_version=$(read_version "$base" "$plugin_json")
    [ -n "$pushed_version" ] || continue
    [ "$pushed_version" != "$(read_version "$local_sha" "$plugin_json")" ] && continue

    echo "pre-push: ${plugin} changed in ${local_ref} but ${plugin_json} version is still ${pushed_version}" >&2
    status=1
  done
done

[ "$status" = 0 ] ||
  echo "pre-push: bump the version and commit it (pre-commit does this when core.hooksPath=.githooks)" >&2
exit $status
