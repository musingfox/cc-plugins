filters:
  and:
    - file.inFolder("pm/demo")
formulas:
  display: if(title, title, file.name)
  days_until_due: if(due, (date(due) - today()).days, "")
properties:
  formula.display:
    displayName: Title
  formula.days_until_due:
    displayName: Days Until Due
views:
  - type: table
    name: Active
    groupBy:
      property: status
      direction: ASC
    filters:
      and:
        - type == "task"
        - status != "done"
    order:
      - formula.display
      - status
      - priority
      - due
      - formula.days_until_due
      - tags
  - type: table
    name: Blocked
    filters:
      and:
        - type == "task"
        - status != "done"
        - not:
            - blocked_by.isEmpty()
    order:
      - formula.display
      - blocked_by
      - priority
      - due
  - type: table
    name: By Parent
    groupBy:
      property: parent
      direction: ASC
    filters:
      and:
        - type == "task"
        - status != "done"
    order:
      - formula.display
      - status
      - priority
      - due
  - type: table
    name: Recently Completed
    filters:
      and:
        - type == "task"
        - status == "done"
    order:
      - formula.display
      - completed
      - tags
    limit: 10
  - type: table
    name: By Tag
    groupBy:
      property: tags
      direction: ASC
    filters:
      and:
        - type == "task"
        - status != "done"
    order:
      - formula.display
      - status
      - tags
  - type: table
    name: Docs
    groupBy:
      property: type
      direction: ASC
    filters:
      or:
        - type == "doc"
        - type == "adr"
    order:
      - formula.display
      - type
      - status
      - updated
  - type: table
    name: All Tasks
    filters:
      and:
        - type == "task"
    order:
      - title
      - status
      - priority
      - due
      - completed
      - type
      - tags
