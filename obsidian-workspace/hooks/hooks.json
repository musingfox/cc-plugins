{
  "description": "obw /issue: shows a pm task card in a pane, read through the Obsidian CLI. The writeback hooks append a bound session's progress to its card.",
  "modules": [
    "./register.ts"
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/writeback.sh",
            "args": [
              "prompt"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/writeback.sh",
            "args": [
              "stop"
            ]
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/writeback.sh",
            "args": [
              "permission"
            ]
          }
        ]
      }
    ]
  }
}
